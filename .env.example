# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, never expose to the client/browser.
SUPABASE_SERVICE_ROLE_KEY=

# Paystack — Settings > API Keys & Webhooks
PAYSTACK_SECRET_KEY=

# Your deployed site URL (used for Paystack's payment callback)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Google/Apple sign-in (RHM-102): no env vars needed here — provider
# client IDs/secrets are configured directly in Supabase Dashboard >
# Authentication > Providers, not in this app. Also add this project's
# /auth/callback URL (e.g. https://yourdomain.com/auth/callback) to each
# provider's allowed redirect URLs, or the OAuth buttons will fail with
# a redirect_uri_mismatch error.

# Resend — resend.com/api-keys (RHM-111/112: caretaker availability
# emails — "ask if still available" pings, and any future caretaker
# notifications). Free tier covers early-stage volume comfortably.
RESEND_API_KEY=
# Must be a domain you've verified in Resend, not a raw Gmail/etc address.
RESEND_FROM_EMAIL=Rhoam <notifications@yourdomain.com>
